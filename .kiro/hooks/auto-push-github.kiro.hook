{
  "enabled": true,
  "name": "Auto-push to GitHub",
  "description": "Automatically commits and pushes all changes to GitHub whenever a file is edited, so changes go live without manual git commands.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.tsx",
      "src/**/*.ts",
      "src/**/*.css",
      "*.json",
      "*.html"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "& \"C:\\Program Files\\Git\\bin\\git.exe\" add -A && & \"C:\\Program Files\\Git\\bin\\git.exe\" commit -m \"auto: update files\" --allow-empty && & \"C:\\Program Files\\Git\\bin\\git.exe\" push",
    "timeout": 30
  }
}