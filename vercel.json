{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/shared-trip.ts": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/trip-seo/:slug", "destination": "/api/shared-trip?slug=:slug" },
    { "source": "/destinations/:city", "destination": "/destinations/:city/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug/index.html" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    }
  ]
}
